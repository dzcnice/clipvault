{
  "name": "clipvault",
  "version": "3.2.1",
  "description": "本地优先的个人凭证与剪贴板工作台",
  "main": "./out/main/index.js",
  "author": "ClipVault",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "assets:icons": "node scripts/generate-icon.js",
    "assets:icons:check": "node scripts/validate-icons.js",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:only": "playwright test",
    "smoke": "node scripts/smoke-test.js",
    "preflight": "node scripts/preflight.js",
    "test:integration": "vitest run src/main/integration src/db/clipboard-encryption.integration.test.ts",
    "rebuild:sqlite": "npm rebuild better-sqlite3 --build-from-source",
    "rebuild:electron": "cross-env npm_config_runtime=electron npm_config_target=37.10.3 npm_config_disturl=https://electronjs.org/headers npm_config_build_from_source=true npm rebuild better-sqlite3",
    "rebuild:electron:script": "node scripts/rebuild-electron.js",
    "check:abi": "node scripts/check-abi.js",
    "security:scan": "node scripts/security-scan.js",
    "release": "node scripts/release.js",
    "release:beta": "node scripts/release.js --channel=beta",
    "release:dry": "node scripts/release.js --dry-run",
    "sign:win": "node scripts/sign.js",
    "smoke:installer": "node scripts/smoke-installer.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "auto-launch": "^5.0.6",
    "better-sqlite3": "^11.6.0",
    "bip39": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.3",
    "i18next": "^26.0.4",
    "kdbxweb": "^2.1.1",
    "lucide-react": "^1.8.0",
    "node-machine-id": "^1.1.12",
    "otpauth": "^9.5.0",
    "qrcode": "^1.5.4",
    "react-i18next": "^17.0.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "uuid": "^10.0.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/auto-launch": "^5.0.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/zxcvbn": "^4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.19",
    "electron": "^37.10.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.38",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^4.1.4"
  }
}
