{
  "name": "clipvault-workbench-preview",
  "version": "3.4.0",
  "description": "本地优先的个人凭证与剪贴板工作台",
  "main": "./out/main/index.js",
  "author": "ClipVault",
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "^22.22.1"
  },
  "overrides": {
    "zod": "4.6.6",
    "@xmldom/xmldom": "^0.8.15",
    "@modelcontextprotocol/client": "^2.3.0",
    "vite": "$vite",
    "fflate": "0.8.3",
    "postcss-selector-parser": "7.1.6",
    "undici@^7": "7.30.1",
    "undici@^8": "8.12.2"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:harness && electron-vite build",
    "build:harness": "node scripts/build-harness.mjs",
    "verify:harness": "node scripts/verify-official-harness.mjs",
    "preview": "electron-vite preview",
    "assets:icons": "node scripts/generate-icon.js",
    "assets:icons:check": "node scripts/validate-icons.js",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build:workbench",
    "build:workbench": "npm run build && electron-builder --win --config electron-builder.workbench.yml --publish never",
    "build:mac": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:native": "node scripts/test-electron-node.cjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:only": "playwright test",
    "smoke": "node scripts/smoke-test.js",
    "preflight": "node scripts/preflight.js",
    "test:integration": "vitest run src/main/integration src/db/clipboard-encryption.integration.test.ts",
    "rebuild:sqlite": "npm rebuild better-sqlite3 --build-from-source",
    "rebuild:electron": "cross-env npm_config_runtime=electron npm_config_target=43.8.3 npm_config_disturl=https://electronjs.org/headers npm_config_build_from_source=true npm rebuild better-sqlite3",
    "rebuild:electron:script": "node scripts/rebuild-electron.js",
    "check:abi": "node scripts/check-abi.js",
    "security:scan": "node scripts/security-scan.js",
    "release": "node scripts/release.js",
    "release:beta": "node scripts/release.js --channel=beta",
    "release:dry": "node scripts/release.js --dry-run",
    "sign:win": "node scripts/sign.js",
    "smoke:installer": "node scripts/smoke-installer.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "auto-launch": "^5.0.6",
    "better-sqlite3": "13.0.3",
    "bip39": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "6.8.11",
    "i18next": "^26.0.4",
    "kdbxweb": "^2.1.1",
    "lucide-react": "^1.8.0",
    "node-machine-id": "^1.1.12",
    "otpauth": "^9.5.0",
    "qrcode": "^1.5.4",
    "react-i18next": "^17.0.2",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.5.0",
    "uuid": "11.1.1",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/auto-launch": "^5.0.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/zxcvbn": "^4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.4.19",
    "electron": "43.8.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "postcss": "8.5.31",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "productName": "ClipVault Workbench Preview"
}
