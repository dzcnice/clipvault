# ============================================================
# ClipVault v2.0 · Vera AI Gateway 开发期凭证
# ------------------------------------------------------------
# 复制为 .env.local（已加入 .gitignore），填入你自己的 DeepSeek
# Key 即可在开发模式下让 Vera 工作。
#
# 生产期：用户在 设置 -> AI 助手 中填入 Key，
#         由 vault DEK 加密后存入 ai_settings.api_key_encrypted。
#         不会读取本文件。
#
# 安全提示：
#   - 永远不要把真实 Key 提交到代码库
#   - 永远不要在源代码里硬编码 sk-xxx
# ============================================================

# 你的 DeepSeek API Key（前往 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：自定义 Base URL（默认 https://api.deepseek.com/v1）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
